name: Build Real iOS App

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: 'latest-stable'
    
    - name: Create Xcode Project with Swift Package
      run: |
        # Create Package.swift if not exists
        if [ ! -f "Package.swift" ]; then
          cat > Package.swift << 'EOF'
        // swift-tools-version:5.9
        import PackageDescription

        let package = Package(
            name: "BLENavigationApp",
            platforms: [
                .iOS(.v14)
            ],
            products: [
                .library(
                    name: "BLENavigationApp",
                    targets: ["BLENavigationApp"])
            ],
            targets: [
                .target(
                    name: "BLENavigationApp",
                    path: ".",
                    sources: [
                        "BLENavigationApp.swift",
                        "ContentView.swift", 
                        "BLEManager.swift",
                        "LocationManager.swift",
                        "NavigationManager.swift",
                        "NavigationData.swift",
                        "NavigationDirection.swift"
                    ],
                    resources: [
                        .process("Info.plist")
                    ]
                )
            ]
        )
        EOF
        fi
        
        # Generate Xcode project from Package
        swift package generate-xcodeproj
    
    - name: Build with xcodebuild
      run: |
        xcodebuild clean build \
          -project BLENavigationApp.xcodeproj \
          -scheme BLENavigationApp \
          -sdk iphoneos \
          -configuration Release \
          -derivedDataPath ./build \
          CODE_SIGN_IDENTITY="" \
          CODE_SIGNING_REQUIRED=NO \
          CODE_SIGNING_ALLOWED=NO
    
    - name: Create IPA from build
      run: |
        # Find the .app bundle
        APP_PATH=$(find ./build -name "*.app" | head -n 1)
        echo "Found app at: $APP_PATH"
        
        # Create Payload directory
        mkdir -p Payload
        cp -r "$APP_PATH" Payload/
        
        # Create IPA
        zip -r BLENavigationApp.ipa Payload
        
        # Verify
        echo "=== IPA Contents ==="
        unzip -l BLENavigationApp.ipa | head -20
    
    - name: Upload IPA
      uses: actions/upload-artifact@v4
      with:
        name: BLENavigationApp-IPA
        path: BLENavigationApp.ipa
        retention-days: 90
